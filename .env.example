# MEVEST Africa Vault Environment Variables
# Copy this file to .env and fill in your actual credentials

# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Edge Function Secrets (from Supabase project settings)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI API Keys (choose one provider)
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Or OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# Or OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key

# Market Data API Keys (optional)
# Alpha Vantage API Key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Finnhub API Key
FINNHUB_KEY=your_finnhub_key

# CoinGecko API Key (optional, rate limited)
COINGECKO_KEY=your_coingecko_key

# Application Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (for production)
VITE_ALLOWED_ORIGINS=https://yourdomain.com

# Session Configuration
VITE_SESSION_TIMEOUT=3600000
VITE_REFRESH_TOKEN_INTERVAL=86400000

# Market Data Caching
VITE_MARKET_DATA_CACHE_TTL=1800000
VITE_QUOTES_CACHE_TTL=30000

# AI Configuration
VITE_AI_MODEL=gemini-1.5-flash
VITE_AI_MAX_TOKENS=1000
VITE_AI_TEMPERATURE=0.7

# UI Configuration
VITE_APP_TITLE=MEVEST Africa Vault
VITE_APP_DESCRIPTION=Institutional-grade wealth management platform
VITE_APP_VERSION=1.0.0

# Analytics Configuration
VITE_ENABLE_ANALYTICS=true
VITE_GA_MEASUREMENT_ID=your_ga_id
VITE_SENTRY_DSN=your_sentry_dsn

# Features Configuration
VITE_ENABLE_REAL_TIME_MARKETS=true
VITE_ENABLE_AI_CHATBOT=true
VITE_ENABLE_ADVANCED_ANALYTICS=true
VITE_ENABLE_STAKING_FEATURES=true

# Development Configuration
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_PERF_MONITORING=true
VITE_ENABLE_MOCK_DATA=false